<Window x:Class="PinkSlipsTool.StealPlayerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steal Player" Height="620" Width="1040"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#1A1A1A" WindowStartupLocation="CenterOwner">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Select a team, then a player to steal:" Foreground="#FFD700"
               FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <!-- Team list -->
      <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="6" Padding="8"
              BorderBrush="#555" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="TEAMS" Foreground="#FF4FA3" FontSize="12" FontWeight="Bold"
                     HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <ListBox x:Name="TeamListBox" Grid.Row="1" Background="#1A1A1A" Foreground="White"
                   BorderThickness="0" SelectionChanged="TeamList_SelectionChanged"
                   ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="White" FontSize="13" Padding="4,2"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="TeamCountText" Grid.Row="2" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
        </Grid>
      </Border>

      <!-- Player list -->
      <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="6" Padding="8"
              BorderBrush="#555" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="RosterHeader" Text="ROSTER" Foreground="#FF4FA3" FontSize="12"
                     FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <ListBox x:Name="PlayerListBox" Grid.Row="1" Background="#1A1A1A" Foreground="White"
                   BorderThickness="0" SelectionChanged="PlayerList_SelectionChanged"
                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                   FontFamily="Consolas" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Foreground="White" Padding="2,1"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="PlayerCountText" Grid.Row="2" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
        </Grid>
      </Border>

      <!-- Swap-out list (your roster) -->
      <Border Grid.Column="4" Background="#2A2A2A" CornerRadius="6" Padding="8"
              BorderBrush="#FF4FA3" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="YourRosterHeader" Text="YOUR ROSTER — PICK CUT" Foreground="#FF4FA3"
                     FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <TextBlock x:Name="SwapHintText" Grid.Row="1" Text="Select a player to swap out (or cut if your roster is full)."
                     Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ListBox x:Name="YourRosterBox" Grid.Row="2" Background="#1A1A1A" Foreground="White"
                   BorderThickness="0" SelectionChanged="YourRosterList_SelectionChanged"
                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                   FontFamily="Consolas" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding CutDisplay}" Foreground="White" Padding="2,1"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="YourRosterCountText" Grid.Row="3" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
          <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <Button x:Name="TransferButton" Content="TRANSFER (SWAP TEAMS)" IsEnabled="False"
                    Style="{StaticResource PinkButton}" FontSize="13" Padding="12,7" Margin="0,0,0,6"
                    Click="TransferButton_Click" />
            <Button x:Name="CutButton" Content="CUT SELECTED" IsEnabled="False"
                    Style="{StaticResource PinkButton}" FontSize="13" Padding="12,7"
                    Click="CutButton_Click" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom bar -->
    <Border Grid.Row="2" Background="#222" CornerRadius="6" Padding="10" Margin="0,10,0,0"
            BorderBrush="#555" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#FFD700" FontSize="13"
                   VerticalAlignment="Center"/>
        <Button x:Name="StealButton" Grid.Column="1" Content="STEAL PLAYER" IsEnabled="False"
                Style="{StaticResource PinkButton}" FontSize="14" Padding="20,8"
                Click="StealButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
