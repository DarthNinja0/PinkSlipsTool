<Window x:Class="PinkSlipsTool.DevUpgradePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upgrade Dev Trait" Height="500" Width="600"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#1A1A1A" WindowStartupLocation="CenterOwner">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Select a player to upgrade their development trait:"
               Foreground="#FFD700" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

    <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Padding="10"
            BorderBrush="#555" BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="HeaderText" Text="YOUR ROSTER" Foreground="#FF4FA3"
                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <ListBox x:Name="PlayerListBox" Background="#1A1A1A" Foreground="White"
                 BorderThickness="0" SelectionChanged="PlayerList_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" Height="340">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Display}" Foreground="White" Padding="3,2"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="CountText" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#222" CornerRadius="6" Padding="10" Margin="0,10,0,0"
            BorderBrush="#555" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#FFD700" FontSize="13"
                   VerticalAlignment="Center"/>
        <Button x:Name="UpgradeButton" Grid.Column="1" Content="UPGRADE DEV TRAIT" IsEnabled="False"
                Style="{StaticResource PinkButton}" FontSize="14" Padding="20,8"
                Click="UpgradeButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
