<Window x:Class="PinkSlipsTool.TransferShockPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Shock" Height="560" Width="760"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#1A1A1A" WindowStartupLocation="CenterOwner">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Pick one of YOUR players to send to a rival team (penalty):"
               Foreground="#FFD700" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>

      <!-- Your roster -->
      <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="6" Padding="8"
              BorderBrush="#FF4FA3" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="YourRosterHeader" Text="YOUR ROSTER" Foreground="#FF4FA3" FontSize="12"
                     FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <ListBox x:Name="YourRosterBox" Grid.Row="1" Background="#1A1A1A" Foreground="White"
                   BorderThickness="0" SelectionChanged="YourRoster_SelectionChanged"
                   ScrollViewer.VerticalScrollBarVisibility="Visible"
                   FontFamily="Consolas" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Foreground="White" Padding="2,1"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Rival teams -->
      <Border Grid.Column="2" Background="#2A2A2A" CornerRadius="6" Padding="8"
              BorderBrush="#555" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="RIVAL TEAMS" Foreground="#FF4FA3" FontSize="12" FontWeight="Bold"
                     HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <ListBox x:Name="RivalTeamBox" Grid.Row="1" Background="#1A1A1A" Foreground="White"
                   BorderThickness="0" SelectionChanged="RivalTeam_SelectionChanged"
                   ScrollViewer.VerticalScrollBarVisibility="Visible">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="White" FontSize="13" Padding="4,2"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom bar -->
    <Border Grid.Row="2" Background="#222" CornerRadius="6" Padding="10" Margin="0,10,0,0"
            BorderBrush="#555" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#FFD700" FontSize="13"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Name="TransferButton" Grid.Column="1" Content="SEND TO RIVAL" IsEnabled="False"
                Style="{StaticResource PinkButton}" FontSize="14" Padding="20,8"
                Click="TransferButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
