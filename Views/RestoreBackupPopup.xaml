<Window x:Class="PinkSlipsTool.RestoreBackupPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Backup" Height="460" Width="580"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#1A1A1A" WindowStartupLocation="CenterOwner">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Pick a backup to restore (newest first):"
               Foreground="#FFD700" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

    <Border Grid.Row="1" Background="#2A2A2A" CornerRadius="6" Padding="10"
            BorderBrush="#555" BorderThickness="1">
      <StackPanel>
        <ListBox x:Name="BackupListBox" Background="#1A1A1A" Foreground="White"
                 BorderThickness="0" SelectionChanged="BackupList_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" Height="300">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Display}" Foreground="White" Padding="3,2"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="CountText" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#222" CornerRadius="6" Padding="10" Margin="0,10,0,0"
            BorderBrush="#555" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#FFD700" FontSize="12"
                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"
                   Text="Restore reloads this backup into the editor. Use 💾 Save to write it out."/>
        <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}"
                Background="#555" Margin="0,0,6,0" Padding="14,6"
                Click="CancelButton_Click" />
        <Button x:Name="RestoreButton" Grid.Column="2" Content="RESTORE" IsEnabled="False"
                Style="{StaticResource PinkButton}" FontSize="13" Padding="16,6"
                Click="RestoreButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
