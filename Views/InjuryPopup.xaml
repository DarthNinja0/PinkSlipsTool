<Window x:Class="PinkSlipsTool.InjuryPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drug Test — Injure a Player" Height="550" Width="750"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#1A1A1A" WindowStartupLocation="CenterOwner">
  <Grid Margin="15">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="InstructionText" Grid.Row="0" Text="Pick one of YOUR players to get a game-ending injury (penalty):"
               Foreground="#FFD700" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Player list -->
      <Border Grid.Column="0" Background="#2A2A2A" CornerRadius="6" Padding="8"
              BorderBrush="#555" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="RosterHeader" Text="ROSTER" Foreground="#FF4FA3" FontSize="12"
                     FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
            <TextBlock Text="Sort:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="SortBox" Width="110" Background="#1A1A1A" Foreground="White"
                      SelectionChanged="SortBox_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem Content="OVR"/>
              <ComboBoxItem Content="Name"/>
              <ComboBoxItem Content="Position"/>
            </ComboBox>
          </StackPanel>
          <ListBox x:Name="PlayerListBox" Background="#1A1A1A" Foreground="White"
                   BorderThickness="0" SelectionChanged="PlayerList_SelectionChanged"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Foreground="White" Padding="2,1"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="PlayerCountText" Foreground="#888" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bottom bar -->
    <Border Grid.Row="2" Background="#222" CornerRadius="6" Padding="10" Margin="0,10,0,0"
            BorderBrush="#555" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#FFD700" FontSize="13"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Name="InjureButton" Grid.Column="1" Content="GIVE INJURY" IsEnabled="False"
                Style="{StaticResource PinkButton}" FontSize="14" Padding="20,8"
                Click="InjureButton_Click" />
      </Grid>
    </Border>
  </Grid>
</Window>
