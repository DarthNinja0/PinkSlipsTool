<Window x:Class="PinkSlipsTool.PinkSlipsWheelPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pink Slips Wheel" Height="650" Width="600"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="#1A1A1A" WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title -->
    <TextBlock Text="★ PINK SLIPS WHEEL ★" FontFamily="Impact" FontSize="28"
               Foreground="#FF4FA3" HorizontalAlignment="Center" Grid.Row="0" />

    <!-- Wheel container: rotating canvas + fixed pointer overlay -->
    <Grid Grid.Row="1" Width="450" Height="450"
          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,10">
      <Canvas x:Name="WheelContent" Width="450" Height="450" ClipToBounds="True">
        <!-- Slices and labels drawn in code-behind -->
      </Canvas>
      <!-- Fixed pointer overlay (does not rotate) -->
      <Canvas Width="450" Height="450" IsHitTestVisible="False">
        <Polygon Points="215,0 235,0 225,20" Fill="White" Stroke="Black" StrokeThickness="1" />
      </Canvas>
      <!-- Fixed hub + logo overlay (does not rotate) -->
      <Canvas x:Name="HubOverlay" Width="450" Height="450" IsHitTestVisible="False" />
    </Grid>

    <!-- Result Banner -->
    <Border x:Name="ResultBanner" Grid.Row="2" Background="#FF4FA3"
            CornerRadius="8" Padding="15,8" Margin="40,0"
            Visibility="Collapsed">
      <TextBlock x:Name="ResultText" FontSize="20" FontWeight="Bold"
                 Foreground="White" HorizontalAlignment="Center" />
    </Border>

    <!-- Spin / Apply Button -->
    <Grid Grid.Row="3" Margin="0,15,0,10">
      <Button x:Name="SpinButton" Content="CLICK TO SPIN"
              Background="#FF4FA3" Foreground="White"
              FontWeight="Bold" FontSize="20" Width="250" Height="55"
              HorizontalAlignment="Center"
              Click="SpinButton_Click" />
      <Button x:Name="ApplyButton" Content="APPLY PERK"
              Background="#32CD32" Foreground="White"
              FontWeight="Bold" FontSize="20" Width="250" Height="55"
              HorizontalAlignment="Center" Visibility="Collapsed"
              Click="ApplyButton_Click" />
    </Grid>
  </Grid>
</Window>
